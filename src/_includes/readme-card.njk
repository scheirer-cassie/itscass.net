{%- from "macros.njk" import pic -%}
<article class="readme" data-start="{{ p.data.start }}"{% if p.data | isOngoing %} data-ongoing{% endif %} data-title="{{ p.data.title | lower }}" data-kw="{% for k in p.data.keywords %}|{{ k | kwslug }}{% endfor %}|">
<header class="chead">
<h2 class="ctitle"><a href="{{ p.url }}">{{ p.data.title }}</a></h2>
<p class="cyears">{{ p.data | years }}</p>
</header>
<a class="imglink" href="{{ p.url }}" tabindex="-1" aria-hidden="true">{{ pic(p.data.hero, p.inputPath, p.data.hero_alt or p.data.title, "rimg", p.data.tint, "(min-width: 900px) 400px, 100vw") }}</a>
<p class="ctext">{{ p.data.research_question or p.data.summary }}</p>
</article>
